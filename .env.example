# Copy this file to .env and fill the generated values.
# .env is ignored by Git and must never be committed.

LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.109.0
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000

# Generated by scripts/new-env.ps1. Keep both values stable.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Postgres is local-only by default. Use a long random value for shared machines.
POSTGRES_PASSWORD=

# Add only the providers you intend to enable.
OPENAI_API_KEY=
GEMINI_API_KEY=
BBAI_API_KEY=
OPENCODE_API_KEY=
OPENLUX_API_KEY=
