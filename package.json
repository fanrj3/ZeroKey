{
  "name": "zerokey-desktop",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --offline",
    "test:ui": "vitest run",
    "test:mcp": "node --test tests/mcp/*.test.ts",
    "test:mcp:live": "node scripts/verify-mcp.ts",
    "mcp": "node scripts/mcp.ts",
    "mcp:config": "node scripts/mcp-config.ts",
    "check": "tsc -b && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "format": "prettier --write src scripts/*.ts",
    "prepare:agent": "node scripts/prepare-agent.mjs",
    "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "release:build": "npm run prepare:runtime && tauri build --bundles nsis"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanrj3/ZeroKey.git"
  }
}
